# Application Environment Settings
APP_ENV=development
PORT=8080

# Centralized AlloyDB / PostgreSQL Connection
DATABASE_URL=postgresql://alloy_admin:alloysecret@localhost:5432/policy_orchestration
DB_POOL_SIZE=10
DB_TIMEOUT_MS=5000

# Centralized Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=telemetry.spans.raw
KAFKA_TOPIC_SANITIZED=telemetry.spans.sanitized
KAFKA_CONSUMER_GROUP=neural-network-telemetry-group

# Centralized OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=neural-network-design

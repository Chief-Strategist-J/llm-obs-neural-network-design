APP_ENV:
  type: string
  enum: [development, test, production]
  default: development
PORT:
  type: integer
  default: 8080
DATABASE_URL:
  type: string
  default: "postgresql://localhost:5432/neural_network_design"
KAFKA_BOOTSTRAP_SERVERS:
  type: string
  default: "localhost:9092"
OTEL_EXPORTER_OTLP_ENDPOINT:
  type: string
  default: "http://localhost:4317"

APP_ENV:
  type: string
  enum: [development, test, production]
  default: development
PORT:
  type: integer
  default: 8080
DATABASE_URL:
  type: string
  default: "postgresql://alloy_admin:alloysecret@localhost:5432/policy_orchestration"
KAFKA_BOOTSTRAP_SERVERS:
  type: string
  default: "localhost:9092"
KAFKA_TOPIC_RAW:
  type: string
  default: "telemetry.spans.raw"
KAFKA_TOPIC_SANITIZED:
  type: string
  default: "telemetry.spans.sanitized"
KAFKA_TOPIC_DLQ:
  type: string
  default: "telemetry.spans.dlq"
KAFKA_CONSUMER_GROUP:
  type: string
  default: "neural-network-telemetry-group"
OTEL_EXPORTER_OTLP_ENDPOINT:
  type: string
  default: "http://localhost:4317"

